  "components": {
    "schemas": {
      "CreateBedDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "bedId": {
            "type": "string",
            "nullable": true
          },
          "bedNumber": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/enumBedStatus"
          },
          "tenantName": {
            "type": "string",
            "nullable": true
          },
          "bedRent": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "rent": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateFlatDto": {
        "required": [
          "apartmentName",
          "flatNumber",
          "userId"
        ],
        "type": "object",
        "properties": {
          "flatNumber": {
            "minLength": 1,
            "type": "string"
          },
          "apartmentName": {
            "minLength": 1,
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "pricingType": {
            "type": "string",
            "nullable": true
          },
          "zones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateZoneDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatePGDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateUserDto": {
        "required": [

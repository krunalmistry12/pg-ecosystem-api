    "/api/Tenants": {
      "post": {
        "tags": [
          "Tenants"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "AllocationType",
                  "FlatId",
                  "JoiningDate",
                  "Name",
                  "Phone",
                  "Rent"
                ],
                "type": "object",
                "properties": {
                  "Name": {
                    "type": "string"
                  },
                  "Phone": {
                    "pattern": "^[0-9]{10}$",

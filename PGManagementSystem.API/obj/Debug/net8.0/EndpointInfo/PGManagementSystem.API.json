                  "FlatId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "AllocationType": {
                    "$ref": "#/components/schemas/enumAllocationType"
                  },
                  "Rent": {
                    "minimum": 1,
                    "type": "number",
                    "format": "double"
                  },
                  "JoiningDate": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "RoomId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "BedId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "Email": {
                    "type": "string"
                  },
                  "EmergencyPhone": {
                    "type": "string"
                  },
                  "Deposit": {
                    "type": "number",
                    "format": "double"
                  },
                  "AdvancePaid": {
                    "type": "number",
                    "format": "double"
                  },
                  "DueDate": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "PaymentMethod": {
                    "type": "string"
                  },
                  "StartingMeterReading": {
                    "type": "number",
                    "format": "double"
                  },
                  "LockInPeriodMonths": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "IdProofType": {
                    "type": "string"
                  },
                  "IdProofNumber": {
                    "type": "string"
                  },
                  "IdProofFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "TenantPhotoFile": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
